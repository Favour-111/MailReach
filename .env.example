# Client settings (Vite). Copy to .env. Everything here is PUBLIC: it ends up in the browser bundle, so never put secrets in it.

# Dev only: where the Vite dev server forwards /api requests (your Express server, see PORT in server/.env)
VITE_PROXY_TARGET=http://localhost:4000

# Dev only: port of the Vite dev server. If you change it, also change CLIENT_URL and GOOGLE_REDIRECT_URI in server/.env
# and the authorised redirect URI in Google Cloud.
VITE_DEV_PORT=5173

# Base path/URL of the API. Leave as /api when the server serves the built app or Vite proxies (recommended).
# A full URL (https://api.example.com/api) only works if you also add CORS + credentials support on the server.
VITE_API_BASE=/api
